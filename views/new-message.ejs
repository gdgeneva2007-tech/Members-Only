<%- include('./partials/header') %>
<div class="max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6">Create message</h1>

  <% if (errors.length) { %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded">
        <% for( let i = 0; i < errors.length; i++ ) { %>
            <p class="text-red-700 text-sm"><%= errors[i].msg %></p>
        <% } %>
    </div>
  <% } %>

  <form action="/messages/new" method="POST" class="space-y-4 bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
      <input type="text" name="title" value="<%= formData?formData.title:"" %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Text</label>
      <input type="text" name="text" value="<%= formData?formData.text:"" %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 font-medium">
      Create Message
    </button>
    <p class="text-center text-sm text-gray-600">
      Go 
      <a href="/" class="text-indigo-600 hover:underline">Home</a>
    </p>
  </form>
</div>
<%- include('./partials/footer') %>